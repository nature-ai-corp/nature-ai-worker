# Copy to .env and adjust. Everything here is optional:
# the model provider and API key can be set in the web UI instead.

# --- Server -------------------------------------------------------------------
# NATURE_WORKER_HOST=127.0.0.1
# NATURE_WORKER_PORT=8080
# NATURE_WORKER_DATA_DIR=./data
# NATURE_WORKER_WORKSPACE=./workspace
# Comma-separated Host header values the server accepts (DNS-rebinding protection).
# Add your hostname if you reach the server by another name. "*" disables the check.
# NATURE_WORKER_ALLOWED_HOSTS=localhost,127.0.0.1

# Docker Compose only: container user/group (default 1000). Use the output of `id -u` / `id -g`.
# NATURE_WORKER_UID=1000
# NATURE_WORKER_GID=1000

# Passphrase used to encrypt API keys saved from the web UI. If unset, a random
# key is generated in the data directory (data/master.key).
# NATURE_WORKER_SECRET_KEY=

# --- Provider API keys (optional; override keys saved in the UI) ----------------
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# DEEPSEEK_API_KEY=
# Sent to whichever OpenAI-compatible endpoint is configured in Settings:
# OPENAI_COMPATIBLE_API_KEY=
#
# Note: SDK overrides such as OPENAI_BASE_URL, ANTHROPIC_BASE_URL or
# OPENAI_CUSTOM_HEADERS are deliberately ignored. Configure endpoints in Settings.
